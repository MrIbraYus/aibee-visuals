# Copy this file to .env.local and fill in your own values.
# Never put real keys in this file: it is committed to git.

# ─── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://aibeevisuals.vercel.app/

# ─── Firebase Client ────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Admin Access ───────────────────────────────────────────────────────
# Comma-separated emails allowed to sign in to /admin with Google
NEXT_PUBLIC_ADMIN_EMAILS=

# ─── Firebase Admin (Server) ────────────────────────────────────────────
# From Firebase console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# ─── Cloudinary ─────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Paystack ───────────────────────────────────────────────────────────
# Use the secret key (sk_test_… / sk_live_…), not the public pk_ key
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_DISCOVERY_FEE_GHS=10

# ─── WhatsApp Business API (optional) ───────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Your number in international format without + (e.g. 233XXXXXXXXX)
WHATSAPP_NOTIFY_TO=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# ─── Admin dashboard (/admin) ───────────────────────────────────────────
# The dashboard PIN is stored (hashed) in Firebase: npm run admin:pin -- 1234
# ADMIN_PASSWORD only overrides it when set (handy without Firebase).
# ADMIN_PASSWORD=
# Long random string used to sign dashboard sessions
ADMIN_SESSION_SECRET=
