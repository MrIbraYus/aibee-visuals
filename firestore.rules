rules_version = '2';

// All reads and writes go through the website's server (Firebase Admin SDK,
// which bypasses these rules): the public pages read published content, and
// the /admin dashboard writes after checking your signed-in session.
// Browsers therefore never need direct database access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
